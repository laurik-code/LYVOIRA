
# LYVOIRA – Environment configuration
# Copy this file to .env.local and fill in your own values.

# SUPABASE – public configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# SUPABASE – server-side secret
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# OPENAI – AI chatbot
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# EMAIL
MAIL_USER=YOUR_EMAIL@example.com
RESEND_API_KEY=YOUR_RESEND_API_KEY

# ADMIN – minimum 16 characters
ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD

# SIGNED FILE URL EXPIRATION (seconds)
SIGNED_URL_EXPIRE=600

# SHOP SUPPORT EMAIL
NEXT_PUBLIC_SHOP_SUPPORT_EMAIL=support@example.com

# LYVOIRA PLAN
# Options: basic, pro, enterprise
NEXT_PUBLIC_LYVOIRA_PLAN=pro

# Demo shop ID created by supabase/seed.sql.
# Replace with your own shop UUID when using another shop.
NEXT_PUBLIC_SHOP_ID=11111111-1111-4111-8111-111111111111
CHAT_SESSION_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_64_CHARACTER_SECRET